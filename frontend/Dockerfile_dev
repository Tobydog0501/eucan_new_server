FROM nginx:1.31.9@sha256:84f7876d21d154885f99554d7ae325d8c2213f9169726ea7ab60642f2573a787


COPY . /usr/share/nginx/html/
RUN find /usr/share/nginx/html/ -type f -exec sed -i 's|https://eucan.ddns.net|http://localhost|g' {} +

# Remove the default nginx.conf
# nginx.conf is needed in the build context for the COPY below, but must not
# be served from the web root.
RUN rm /etc/nginx/conf.d/default.conf /usr/share/nginx/html/nginx.conf

# # Replace with our own nginx.conf
COPY nginx.conf /etc/nginx/conf.d/
