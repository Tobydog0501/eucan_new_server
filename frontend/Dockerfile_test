# Test-site frontend: same as Dockerfile, plus a build-time check that no page
# still names the production host, so the test UI cannot call it.
#   docker build [--build-arg API_BASE=http://<test-host>:3000] -f Dockerfile_test .
# Without API_BASE the pages call port 3000 on the host they were loaded from.
FROM nginx:1.31.9

ARG API_BASE=
# "Cloud history" links on the admin pages: a test folder URL, or empty to hide
# the link. The production folders are never linked from a test build.
ARG CLOUD_HISTORY_URL_CALENDAR=
ARG CLOUD_HISTORY_URL_RECORD=

COPY . /usr/share/nginx/html/
RUN if [ -n "$API_BASE" ]; then \
        echo "$API_BASE" | grep -Eq '^https?://[A-Za-z0-9.-]+(:[0-9]+)?$' \
            || { echo "API_BASE must look like http(s)://host[:port]" >&2; exit 1; }; \
        sed -i "s|^var EUCAN_API_BASE_CONFIGURED = ''; // @API_BASE@|var EUCAN_API_BASE_CONFIGURED = '${API_BASE}'; // @API_BASE@|" \
            /usr/share/nginx/html/js/cookieOperation.js \
        && grep -q "EUCAN_API_BASE_CONFIGURED = '${API_BASE}'" /usr/share/nginx/html/js/cookieOperation.js; \
    fi \
    && if grep -rl --include='*.js' --include='*.html' 'eucan.ddns.net' /usr/share/nginx/html/; then \
        echo "production host still referenced in the files above" >&2; exit 1; \
    fi

RUN sh /usr/share/nginx/html/cloud_links.sh /usr/share/nginx/html hide \
    && if grep -rlE --include='*.html' '1YkJ9qs0lIDk5BfGMr_xV5bA7YmFn7S_p|1_4mNF0GZOGRhZ30ZHcm6zcVxT3oJ1R6E' /usr/share/nginx/html/; then \
        echo "production cloud folder still linked in the files above" >&2; exit 1; \
    fi

# nginx.conf is needed in the build context for the COPY below, but must not
# be served from the web root; cloud_links.sh is a build file.
RUN rm /etc/nginx/conf.d/default.conf /usr/share/nginx/html/nginx.conf /usr/share/nginx/html/cloud_links.sh
COPY nginx.conf /etc/nginx/conf.d/
